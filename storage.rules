rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 100 * 1024; // 100KB max
    }

    // ============================================================================
    // ARTICLE IMAGES - Articles/{articleId}/
    // ============================================================================
    match /articles/{articleId}/{allPaths=**} {
      // Everyone can read article images
      allow read: if true;
      // Any logged-in user can upload (app-level auth, admin panel, and Firestore rules handle role checking)
      allow create, update: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // ============================================================================
    // USER AVATARS - avatars/{userId}/
    // ============================================================================
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId && isValidImage();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================================
    // CATEGORY IMAGES - categories/{categoryId}/
    // ============================================================================
    match /categories/{categoryId}/{allPaths=**} {
      allow read: if true;
      allow create: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // ============================================================================
    // BACKUP/ARCHIVE FILES - backups/{allPaths=**}
    // ============================================================================
    match /backups/{allPaths=**} {
      allow read, write, delete: if request.auth != null;
    }

    // ============================================================================
    // DEFAULT DENY - All other access is denied
    // ============================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}